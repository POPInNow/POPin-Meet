# Application
FLASK_ENV=production
APP_DOMAIN=meet.example.com
SESSION_SECRET=change-this-in-production

# Database
# Examples:
# SQLite (dev): sqlite:///app.db
# Postgres: postgresql+psycopg2://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=sqlite:///app.db

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (SMTP / SES style)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
